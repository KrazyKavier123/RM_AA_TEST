%YAML:1.0
---
# 此文件只定义填写格式，不含可用标定值。
# 完成标定后复制为实际配置文件，填写全部矩阵，并将 calibrated 改为 1。
calibrated: 0

# 标定图像分辨率，单位为 pixel；0 为无效占位值。
image_width: 0
image_height: 0

# 相机内参矩阵 K。以下全零数据仅用于保留 OpenCV YAML 矩阵格式，不能用于运行。
camera_matrix: !!opencv-matrix
  rows: 3
  cols: 3
  dt: d
  data: [ 0., 0., 0.,
          0., 0., 0.,
          0., 0., 0. ]

# 畸变顺序必须与所选标定模型一致，并在报告中说明。
# 默认模板按 OpenCV pinhole 模型保留 [k1, k2, p1, p2, k3] 五个位置。
distortion_coefficients: !!opencv-matrix
  rows: 1
  cols: 5
  dt: d
  data: [ 0., 0., 0., 0., 0. ]

# 从相机坐标系变换到云台坐标系的旋转矩阵 R_gimbal_camera。
# 全零矩阵是无效占位值，禁止将其视为单位旋转。
rotation_camera_to_gimbal: !!opencv-matrix
  rows: 3
  cols: 3
  dt: d
  data: [ 0., 0., 0.,
          0., 0., 0.,
          0., 0., 0. ]

# 相机原点在云台坐标系中的位置 t_gimbal_camera，
# 即从云台原点指向相机原点的平移向量，单位为 m。
translation_camera_to_gimbal: !!opencv-matrix
  rows: 3
  cols: 1
  dt: d
  data: [ 0., 0., 0. ]

# 标定结果记录；负数为未填写占位值。
mean_reprojection_error_px: -1.

# The matrices above must be measured. All extra settings below are application defaults.
source_mode: camera
camera_backend: hikrobot
camera_device: "0"
camera_serial: ""
camera_fps: 60.
exposure_us: 5000.
gain_db: 0.
grab_timeout_ms: 100
video_path: ""
loop_video: 0
classifier_model: "../../src/rm_aa_vision/models/mlp.onnx"
classifier_labels: "../../src/rm_aa_vision/models/label.txt"
confidence_threshold: 0.7
brightness_threshold: 100
opening_radius: 0
max_reprojection_px: 3.
plate_normal_sign: 1.
plate_count: 4
initial_radius_m: 0.25
max_height_difference_m: 0.3
tracker_timeout_s: 0.3
stable_frames: 10
stable_position_variance: 0.01
stable_yaw_variance: 0.1
max_processing_age_s: 0.2
max_prediction_s: 0.8
use_ballistics: 1
bullet_speed_mps: 22.
gravity_mps2: 9.7833
pitch_to_barrel_m: !!opencv-matrix
  rows: 3
  cols: 1
  dt: d
  data: [ 0.0741, 0., 0. ]
# Explicitly enable after measuring the setup; unstable/lost/stale results always inhibit fire.
enable_fire: 0
fire_yaw_tolerance_rad: 0.02
fire_pitch_tolerance_rad: 0.02
# Special-label IDs are not specified by the reference protocol; 0 rejects them.
# Set these only to values agreed with the controller.
outpost_id: 0
guard_id: 0
base_id: 0
