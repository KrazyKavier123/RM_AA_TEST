# Shared by the ROS package and the standalone vision build.
set(MVS_ROOT "/opt/MVS" CACHE PATH "Installed Hikrobot MVS SDK root (include and lib)")
set(_hikrobot_default OFF)
if(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND EXISTS "${MVS_ROOT}/include/MvCameraControl.h")
  set(_hikrobot_default ON)
endif()
option(RM_AA_WITH_HIKROBOT "Build the Hikrobot MVS capture backend" ${_hikrobot_default})

function(rm_aa_enable_hikrobot target)
  if(NOT RM_AA_WITH_HIKROBOT)
    message(STATUS "Hikrobot capture disabled; enable RM_AA_WITH_HIKROBOT with an installed MVS SDK")
    return()
  endif()
  if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
    message(FATAL_ERROR "The supplied MVS SDK is for Linux; use a Linux build or disable RM_AA_WITH_HIKROBOT")
  endif()
  if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64)$")
    set(_mvs_arch aarch64)
  elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "^(arm|armv7.*|armhf)$")
    set(_mvs_arch armhf)
  elseif(CMAKE_SIZEOF_VOID_P EQUAL 8)
    set(_mvs_arch 64)
  else()
    set(_mvs_arch 32)
  endif()
  find_path(MVS_INCLUDE_DIR MvCameraControl.h HINTS "${MVS_ROOT}/include")
  find_library(MVS_LIBRARY NAMES MvCameraControl
    HINTS "${MVS_ROOT}/lib/${_mvs_arch}" "${MVS_ROOT}/lib")
  if(NOT MVS_INCLUDE_DIR OR NOT MVS_LIBRARY)
    message(FATAL_ERROR "MVS headers/library not found. Install the full MVS development package and set MVS_ROOT (runtime-only archives have no headers).")
  endif()
  target_compile_definitions(${target} PRIVATE RM_AA_WITH_HIKROBOT=1)
  target_include_directories(${target} SYSTEM PRIVATE "${MVS_INCLUDE_DIR}")
  target_link_libraries(${target} PUBLIC "${MVS_LIBRARY}")
  # MVS's installer/loader environment must also expose its transport-layer plugins.
  set(CMAKE_INSTALL_RPATH_USE_LINK_PATH TRUE PARENT_SCOPE)
  set_property(TARGET ${target} PROPERTY INSTALL_RPATH_USE_LINK_PATH TRUE)
  message(STATUS "Hikrobot capture enabled: ${MVS_LIBRARY}")
endfunction()
